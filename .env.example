APP_NAME=ActaLab
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://actalab.local

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_DOMAIN=actalab.local
TRUSTED_PROXIES=127.0.0.1
MEETING_AI_DRIVER=openai
MEETING_AUDIO_MAX_SIZE_KB=512000
MEETING_AUDIO_MAX_DURATION_SECONDS=7200
MEETING_AUDIO_CHUNK_SECONDS=900
FFMPEG_BINARY=/opt/homebrew/bin/ffmpeg
FFPROBE_BINARY=/opt/homebrew/bin/ffprobe
AUDIO_RETENTION_DAYS=

SOCRATA_BASE_URL=https://www.datos.gov.co
SOCRATA_APP_TOKEN=
INVESTMENT_SYNC_PAGE_SIZE=1000
INVESTMENT_SYNC_DEFAULT_LIMIT=250
INVESTMENT_STALE_AFTER_DAYS=120
INVESTMENT_LOW_EXECUTION_PERCENT=30
INVESTMENT_PROGRESS_GAP_POINTS=25
INVESTMENT_ENDING_WITHIN_DAYS=120
INVESTMENT_GOVERNMENT_PERIOD_NAME="El Gobierno de la Unidad"
INVESTMENT_GOVERNMENT_START_YEAR=2024
INVESTMENT_GOVERNMENT_END_YEAR=2027
INVESTMENT_META_BOUNDARIES_URL="https://geoportal.dane.gov.co/mparcgis/rest/services/MGN2024/Serv_CapasMGN_2024/FeatureServer/317/query?where=dpto_ccdgo%3D%2750%27&outFields=mpio_cdpmp%2Cmpio_cnmbr&returnGeometry=true&outSR=4326&f=geojson"

# Dominios autorizados para embeber los geovisores publicados.
GEOVISOR_FRAME_ANCESTORS="'self' https://meta.gov.co https://www.meta.gov.co"

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_ANALYSIS_MODEL=gpt-5-mini

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://actalab.local/oauth/google-drive/callback
GOOGLE_DRIVE_ROOT_FOLDER="Actas de reuniones"
